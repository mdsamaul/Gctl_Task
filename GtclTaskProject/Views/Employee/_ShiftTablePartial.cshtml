@model GtclTaskProject.Models.EmployeeShiftViewModel
@{
    int currentPage = (int)ViewBag.CurrentPage;
    int pageSize = (int)ViewBag.PageSize;
    int totalCount = (int)ViewBag.TotalCount;
    int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    string searchString = ViewBag.SearchString ?? "";
    int startRecord = (int)ViewBag.StartRecord;
    int endRecord = (int)ViewBag.EndRecord;
    int displayedCount = (int)ViewBag.DisplayedCount;
}

<table id="productTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>AI_ID</th>
            <th>RosterScheduleCode</th>
            <th>EmployeeID</th>
            <th>Date</th>
            <th>ShiftCode</th>
            <th>Remarks</th>
            <th>EntryDate</th>
            <th>ModifyDate</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.HrmAtdRosterScheduleEntry)
        {
            <tr>
                <td>@item.AiId</td>
                <td>@item.RosterScheduleCode</td>
                <td class="emp-id">@item.EmployeeId</td>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.ShiftCode</td>
                <td>@item.Remarks</td>
                <td>@(item.EntryDate.HasValue ? item.EntryDate.Value.ToString("yyyy-MM-dd") : "")</td>
                <td>@(item.ModifyDate.HasValue ? item.ModifyDate.Value.ToString("yyyy-MM-dd") : "")</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <div class="alert alert-info mb-3 text-center">
        Showing @startRecord to @endRecord of @displayedCount rows out of @totalCount entries
    </div>
</div>

<div class="d-flex justify-content-center align-items-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link page-nav-link" data-page="1" href="#">First</a>
                </li>
                <li class="page-item">
                    <a class="page-link page-nav-link" data-page="@(currentPage - 1)" href="#">Previous</a>
                </li>
            }

            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link page-nav-link" data-page="@i" href="#">@i</a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link page-nav-link" data-page="@(currentPage + 1)" href="#">Next</a>
                </li>
                <li class="page-item">
                    <a class="page-link page-nav-link" data-page="@totalPages" href="#">Last</a>
                </li>
            }
        </ul>
    </nav>
</div>