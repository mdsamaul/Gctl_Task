@model GtclTaskProject.Models.CustomerViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Customer</h4>
<hr />
<div class="row" style="position: relative;">
    <div class="col-md-10">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CustomerId" />

            <div class="form-group">
                <label asp-for="CustomerName" class="control-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BusinessStart" class="control-label"></label>
                <input asp-for="BusinessStart" class="form-control" type="date" />
                <span asp-validation-for="BusinessStart" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CustomerType" class="control-label"></label>
                <input asp-for="CustomerType" class="form-control" />
                <span asp-validation-for="CustomerType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CreditLimit" class="control-label"></label>
                <input asp-for="CreditLimit" class="form-control" />
                <span asp-validation-for="CreditLimit" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhotoFile" class="control-label"></label>
                <input asp-for="PhotoFile" class="form-control" type="file" id="photoFileInput" />
                <span asp-validation-for="PhotoFile" class="text-danger"></span>

                <!-- Image Preview Section -->
                <div class="image-preview-container mt-3 text-center d-flex justify-content-center"
                     style="position: absolute; top: 0; right: 0; z-index: 10; display:none;" id="imagePreview">
                    <div class="card">
                        <div class="card-body p-2 text-center">
                            <img id="previewImage" src="" alt="Preview" class="img-fluid mb-2 border" style="max-height: 150px;" />
                            <div>
                                <button type="button" id="removeImageBtn" class="btn btn-sm btn-danger">
                                    <i class="bi bi-x-circle"></i> Remove
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Existing Image Section -->
                <div id="existingImageContainer" class="mt-2"
                @(string.IsNullOrEmpty(Model.Photo) ? "style='display:none;'" : "")
                     style="position: absolute; top: 0; right: 0; z-index: 10; ">
                    <img src="@Model.Photo" style="max-height: 150px;" alt="Customer Photo" class="border" id="existingImage" />
                    <div class="mt-1">
                        <button type="button" id="removeExistingImageBtn" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i> Remove Image
                        </button>
                        <input type="hidden" asp-for="Photo" id="existingPhotoPath" />
                        <input type="hidden" name="RemoveExistingPhoto" id="removeExistingPhoto" value="false" />
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h4>Delivery Address</h4>
                <div class="mb-3">
                    @*  <button type="button" class="btn btn-primary" id="addDeliveryAddressBtn">Add New Address</button> *@
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Delivery Address</th>
                            <th>Contact Person</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="deliveryAddressContainer">
                        @if (Model.DeliveryAddresses != null && Model.DeliveryAddresses.Any())
                        {
                            for (int i = 0; i < Model.DeliveryAddresses.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="DeliveryAddresses[@i].DeliveryAddressId" value="@Model.DeliveryAddresses[i].DeliveryAddressId" />
                                        <input type="hidden" name="DeliveryAddresses[@i].CustomerId" value="@Model.DeliveryAddresses[i].CustomerId" />
                                        <div class="form-group">
                                            <input name="DeliveryAddresses[@i].DeliveryAddressLine" value="@Model.DeliveryAddresses[i].DeliveryAddressLine" class="form-control" />
                                            <span data-valmsg-for="DeliveryAddresses[@i].DeliveryAddressLine" class="text-danger"></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-group">
                                            <input name="DeliveryAddresses[@i].ContactPerson" value="@Model.DeliveryAddresses[i].ContactPerson" class="form-control" />
                                            <span data-valmsg-for="DeliveryAddresses[@i].ContactPerson" class="text-danger"></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-group">
                                            <input name="DeliveryAddresses[@i].Phone" value="@Model.DeliveryAddresses[i].Phone" class="form-control" />
                                            <span data-valmsg-for="DeliveryAddresses[@i].Phone" class="text-danger"></span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (i == 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary addmore">
                                                Add More
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-danger removeRow">
                                                <i class="bi bi-x-circle"></i> Remove
                                            </button>
                                        }

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Add a default row if no delivery addresses exist -->
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <input name="DeliveryAddresses[0].DeliveryAddressLine" class="form-control" required />
                                        <span class="text-danger" data-valmsg-for="DeliveryAddresses[0].DeliveryAddressLine"></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input name="DeliveryAddresses[0].ContactPerson" class="form-control" required />
                                        <span class="text-danger" data-valmsg-for="DeliveryAddresses[0].ContactPerson"></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group">
                                        <input name="DeliveryAddresses[0].Phone" class="form-control" required />
                                        <span class="text-danger" data-valmsg-for="DeliveryAddresses[0].Phone"></span>
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary addmore">
                                        Add More
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initial row count for delivery addresses
            let rowCount = @(Model.DeliveryAddresses?.Count() ?? 0);
            if (rowCount === 0) {
                rowCount = 1; // Start with one row if none exist.
            }

            // Add more delivery addresses
            $(document).on('click', '.addmore', function() {
                var newRow = `
                    <tr>
                        <td>
                            <div class="form-group">
                                <input name="DeliveryAddresses[${rowCount}].DeliveryAddressLine" class="form-control" required />
                                <span class="text-danger" data-valmsg-for="DeliveryAddresses[${rowCount}].DeliveryAddressLine"></span>
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <input name="DeliveryAddresses[${rowCount}].ContactPerson" class="form-control" required />
                                <span class="text-danger" data-valmsg-for="DeliveryAddresses[${rowCount}].ContactPerson"></span>
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <input name="DeliveryAddresses[${rowCount}].Phone" class="form-control" required />
                                <span class="text-danger" data-valmsg-for="DeliveryAddresses[${rowCount}].Phone"></span>
                            </div>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger removeRow">
                                <i class="bi bi-x-circle"></i> Remove
                            </button>
                        </td>
                    </tr>
                `;
                $("#deliveryAddressContainer").append(newRow);
                rowCount++;
            });

            // Remove delivery address row
            $(document).on('click', '.removeRow', function() {
                $(this).closest('tr').remove();
                reindexAddressRows();
            });

            function reindexAddressRows() {
                $("#deliveryAddressContainer tr").each(function (index) {
                    $(this).find('input').each(function() {
                        var name = $(this).attr('name');
                        if (name) {
                            // Replace the index in the name attribute
                            var newName = name.replace(/\[\d+\]/, '[' + index + ']');
                            $(this).attr('name', newName);
                        }
                    });

                    // Update validation error spans
                    $(this).find('span[data-valmsg-for]').each(function() {
                        var valFor = $(this).attr('data-valmsg-for');
                        if (valFor) {
                            var newValFor = valFor.replace(/\[\d+\]/, '[' + index + ']');
                            $(this).attr('data-valmsg-for', newValFor);
                        }
                    });

                    // Update button classes and text based on row index
                    $(this).find('button').each(function() {
                        if (index == 0) {
                            $(this).removeClass('btn-danger removeRow').addClass("btn-primary addmore")
                                .html("Add More");
                        } else {
                            $(this).removeClass('btn-primary addmore').addClass("btn-danger removeRow")
                                .html('<i class="bi bi-x-circle"></i> Remove');
                        }
                    });
                });

                rowCount = $("#deliveryAddressContainer tr").length;
                if (rowCount == 0) {
                    var newRow = `
                        <tr>
                            <td>
                                <div class="form-group">
                                    <input name="DeliveryAddresses[0].DeliveryAddressLine" class="form-control" required />
                                    <span class="text-danger" data-valmsg-for="DeliveryAddresses[0].DeliveryAddressLine"></span>
                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <input name="DeliveryAddresses[0].ContactPerson" class="form-control" required />
                                    <span class="text-danger" data-valmsg-for="DeliveryAddresses[0].ContactPerson"></span>
                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <input name="DeliveryAddresses[0].Phone" class="form-control" required />
                                    <span class="text-danger" data-valmsg-for="DeliveryAddresses[0].Phone"></span>
                                </div>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-primary addmore">
                                    Add More
                                </button>
                            </td>
                        </tr>`;
                    $("#deliveryAddressContainer").append(newRow);
                    rowCount = 1;
                }
            }

            // Image preview for new uploads
            $('#photoFileInput').change(function(event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        // Hide existing image when a new one is selected
                        $('#existingImageContainer').hide();

                        // Show the preview for the new image
                        $('#imagePreview').show();
                        $('#previewImage').attr('src', e.target.result);

                        // Set the remove existing photo flag to true since we're replacing it
                        $('#removeExistingPhoto').val('true');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Remove new image preview
            $('#removeImageBtn').click(function() {
                $('#photoFileInput').val(''); // Clear the file input
                $('#imagePreview').hide(); // Hide the preview
                $('#previewImage').attr('src', ''); // Clear the image source

                // If there was an existing image, show it again and don't remove it
                if ($('#existingPhotoPath').val()) {
                    $('#existingImageContainer').show();
                    $('#removeExistingPhoto').val('false');
                }
            });

            // Remove existing image
            $('#removeExistingImageBtn').click(function() {
                $('#existingImageContainer').hide();
                $('#removeExistingPhoto').val('true');

                // Clear the file input in case a new file was also selected
                $('#photoFileInput').val('');
                $('#imagePreview').hide();
                $('#previewImage').attr('src', '');
            });
        });
    </script>
}