
@model GtclTaskProject.Models.DeliveryAddress
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    int index = (int)ViewBag.Index;
    string fieldPrefix = $"DeliveryAddresses[{index}]"; 
}

<tr class="rc">
    <td>
        <div class="form-group">
            <input asp-for="DeliveryAddressLine" class="form-control" asp-for-prefix="@fieldPrefix" />
            <span asp-validation-for="DeliveryAddressLine" class="text-danger" asp-validation-for-prefix="@fieldPrefix"></span>
        </div>
    </td>
    <td>
        <div class="form-group">
            <input asp-for="ContactPerson" class="form-control" asp-for-prefix="@fieldPrefix" />
            <span asp-validation-for="ContactPerson" class="text-danger" asp-validation-for-prefix="@fieldPrefix"></span>
        </div>
    </td>
    <td>
        <div class="form-group">
            <input asp-for="Phone" class="form-control" asp-for-prefix="@fieldPrefix" />
            <span asp-validation-for="Phone" class="text-danger" asp-validation-for-prefix="@fieldPrefix"></span>
        </div>
    </td>
    <td>
        <button type="button" class="btn btn-danger removeDelivery">Remove</button>
    </td>
</tr>

