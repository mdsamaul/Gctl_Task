

@model IEnumerable<GtclTaskProject.Models.Customer>

@{
    ViewData["Title"] = "Export Customer Data";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">Customer Data Export</h1>

    <div class="row mb-4">
        <div class="col-12 d-flex">
            <div class="col-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        Date Range Filter
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label for="startDate">From Date</label>
                                    <input type="date" id="startDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label for="endDate">To Date</label>
                                    <input type="date" id="endDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button id="filterDateBtn" class="btn btn-primary">Filter</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card col-6">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Export Options</h5>
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <form asp-action="ExportToCsv" method="post">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="fas fa-file-csv me-1"></i> CSV
                        </button>
                    </form>

                    <form asp-action="ExportToExcel" method="post">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-file-excel me-1"></i> Excel
                        </button>
                    </form>

                    <form asp-action="ExportToWord" method="post">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-file-word me-1"></i> Word
                        </button>
                    </form>

                    <form asp-action="ExportToPdf" method="post" target="_blank">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-file-pdf me-1"></i> PDF
                        </button>
                    </form>

                    <form asp-action="ExportJson" method="post">
                        <button type="submit" class="btn btn-info">
                            <i class="fas fa-file-code me-1"></i> JSON
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Customer Data</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="customerTable" class="table table-striped table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Address</th>
                                    <th>Business Start</th>
                                    <th>Customer Type</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Credit Limit</th>
                                    <th>Actions</th>
                                    <th>Address</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.CustomerName</td>
                                        <td>@item.Address</td>
                                        <td>@item.BusinessStart?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.CustomerType</td>
                                        <td>@item.Phone</td>
                                        <td>@item.Email</td>
                                        <td>@item.CreditLimit</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary preview-btn"
                                                    data-id="@item.CustomerId" data-bs-toggle="modal"
                                                    data-bs-target="#previewModal">
                                                <i class="fas fa-eye"></i> Preview
                                            </button>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#addressModal-@item.CustomerId">
                                                See Addresses
                                            </button>

                                            <div class="modal fade" id="addressModal-@item.CustomerId" tabindex="-1" aria-labelledby="addressModalLabel-@item.CustomerId" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="addressModalLabel-@item.CustomerId">Delivery Addresses for @item.CustomerName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <table class="table table-bordered">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Delivery Address ID</th>
                                                                        <th>Address Line</th>
                                                                        <th>Contact Person</th>
                                                                        <th>Phone</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var address in item.DeliveryAddresses)
                                                                    {
                                                                        <tr>
                                                                            <td>@address.DeliveryAddressId</td>
                                                                            <td>@address.DeliveryAddressLine</td>
                                                                            <td>@address.ContactPerson</td>
                                                                            <td>@address.Phone</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Customer Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="previewContent">
            <!-- Content will be loaded here -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with date range filtering capability
            var table = $('#customerTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]]
            });

            // Custom date range filtering function
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    var startDate = $('#startDate').val();
                    var endDate = $('#endDate').val();
                    var dateColumn = data[2]; // Index of "Business Start" column

                    // If no dates are selected, show all rows
                    if (!startDate && !endDate) {
                        return true;
                    }

                    // Parse dates for comparison
                    var rowDate = new Date(dateColumn);
                    var filterStartDate = startDate ? new Date(startDate) : null;
                    var filterEndDate = endDate ? new Date(endDate) : null;

                    // Check if the date is within the selected range
                    if (filterStartDate && filterEndDate) {
                        return rowDate >= filterStartDate && rowDate <= filterEndDate;
                    } else if (filterStartDate) {
                        return rowDate >= filterStartDate;
                    } else if (filterEndDate) {
                        return rowDate <= filterEndDate;
                    }

                    // Default case
                    return true;
                }
            );

            // Apply filter when the filter button is clicked
            $('#filterDateBtn').click(function() {
                table.draw();
            });

            // Reset date filters
            $('#clearDateFilterBtn').click(function() {
                $('#startDate').val('');
                $('#endDate').val('');
                table.draw();
            });

            $(".column-filter").change(function () {
                var column = $(this).data("column");
                var value = $(this).val();
                table.column(column).search(value).draw();
            });

            $(".customer-name-filter").change(function () {
                var selectedValues = $(".customer-name-filter:checked").map(function () {
                    return this.value;
                }).get();

                if (selectedValues.length === 0) {
                    table.column(0).search('').draw();
                } else {
                    var pattern = selectedValues.join("|");
                    table.column(0).search(pattern, true, false).draw();
                }
            });

            // Preview functionality
            $('.preview-btn').click(function() {
                var customerId = $(this).data('id');
                $('#previewContent').html('<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">Loading...</p></div>');

                $.ajax({
                    url: '@Url.Action("PreviewCustomer", "CustomerInformation")/' + customerId,
                    type: 'GET',
                    success: function(result) {
                        $('#previewContent').html(result);
                    },
                    error: function() {
                        $('#previewContent').html('<div class="modal-content"><div class="modal-body"><div class="alert alert-danger">Failed to load customer data. Please try again.</div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div>');
                    }
                });
            });
        });
    </script>
}