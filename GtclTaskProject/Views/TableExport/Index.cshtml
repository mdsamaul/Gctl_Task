@model IEnumerable<GtclTaskProject.Models.Customer>

@{
    ViewData["Title"] = "Export Customer Data";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">Customer Data Export</h1>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Export Options</h5>
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <form asp-action="ExportToCsv" method="post">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="fas fa-file-csv me-1"></i> CSV
                        </button>
                    </form>

                    <form asp-action="ExportToExcel" method="post">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-file-excel me-1"></i> Excel
                        </button>
                    </form>

                    <form asp-action="ExportToWord" method="post">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-file-word me-1"></i> Word
                        </button>
                    </form>

                    <form asp-action="ExportToPdf" method="post" target="_blank">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-file-pdf me-1"></i> PDF
                        </button>
                    </form>

                    <form asp-action="ExportJson" method="post">
                        <button type="submit" class="btn btn-info">
                            <i class="fas fa-file-code me-1"></i> JSON
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Customer Data</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="customerTable" class="table table-striped table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Address</th>
                                    <th>Business Start</th>
                                    <th>Customer Type</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Credit Limit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.CustomerName</td>
                                        <td>@item.Address</td>
                                        <td>@item.BusinessStart?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.CustomerType</td>
                                        <td>@item.Phone</td>
                                        <td>@item.Email</td>
                                        <td>@item.CreditLimit</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#customerTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]]
            });
        });
    </script>
}