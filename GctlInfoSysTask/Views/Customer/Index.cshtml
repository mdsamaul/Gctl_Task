        function loadCustomerTable() {
            $.ajax({
                url: "/Customer/GetCustomerTable",
                type: "GET",
                success: function (res) {
                    if ($.fn.DataTable.isDataTable("#customerTable")) {
                        $('#customerTable').DataTable().destroy();
                    }

                    $("#customerTableBody").html(res);

                    $("#customerTable").DataTable({
                        "pageLength": 5,
                        "lengthMenu": [5, 10, 15, 20],
                        "ordering": true,
                        "info": true,
                        "searching": true,
                        "autoWidth": false
                    });
                }
            });
        }

       
        $(document).ready(function () {
            // loadCustomerTable();

            // Select All Checkbox
            $("#selectAll").click(function () {
                $(".selectCheckBox").prop('checked', this.checked);
                $("#deleteBtn").toggle();
                $("#deleteSelected").toggle();
            });

            $(document).on('change', ".selectCheckBox", function(){
                var totalSelect = $('.selectCheckBox').length;
                var checkCheckbox = $(".selectCheckBox:checked").length;
                // console.log(checkCheckbox);
                if (checkCheckbox > 0) {
                    $("#deleteSelected").show();
                    $("#deleteBtn").hide();
                }else{
                    $("#deleteSelected").hide();
                    $("#deleteBtn").show();
                }
                if (totalSelect === checkCheckbox) {
                  $("#selectAll").prop('checked', true)
              }else{
                  $("#selectAll").prop('checked', false);
              }
            })
            // Delete Selected Customers
            $("#deleteSelected").click(function () {
                var selectedIds = $(".selectCheckBox:checked").map(function () {
                    return $(this).val();
                }).get();

                if (selectedIds.length === 0) {
                    $(".deleteMassage").removeClass("d-none").text("Please select at least one customer.").delay(3000).fadeOut();
                    return;
                }

                $.ajax({
                    url: '/Customer/deleteCustomerSelected',
                    type: 'POST',
                    data: { ids: selectedIds },
                    success: function (res) {
                        console.log("click", res);
                        if (res.success) {
                            loadCustomerTable();
                            $("#selectAll").prop('checked', false);
                            $(".successMassage").removeClass("d-none").text("Selected customers deleted successfully!").delay(3000).fadeOut();
                        } else {
                            $(".deleteMassage").removeClass("d-none").text("Something went wrong.").delay(3000).fadeOut();
                        }
                    },
                    error: function () {
                        $(".deleteMassage").removeClass("d-none").text("Error occurred while deleting.").delay(3000).fadeOut();
                    }
                });
            });

            // Single Delete Button
            $(document).on('click', '.delete-button', function () {
                var id = $(this).data('id');
                var row = $(this).closest('tr');

                if (!confirm("Are you sure to delete this customer?")) return;

                $.ajax({
                    url: '/Customer/Delete/' + id,
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            row.remove();
                            $(".successMassage").removeClass("d-none").text('Customer deleted successfully!').delay(3000).fadeOut();
                        } else {
                            $(".deleteMassage").removeClass("d-none").text("Failed to delete.").delay(3000).fadeOut();
                        }
                    },
                    error: function () {
                        $(".deleteMassage").removeClass("d-none").text("Error occurred while deleting.").delay(3000).fadeOut();
                    }
                });
            });
        });

        $(document).ready(function(){
            $("#downloadSelectedPdf").click(function(){
            console.log("click");
          var selectIds = [];
              $(".selectCheckBox:checked").each(function(){
          selectIds.push($(this).val());
          });
          if(selectIds.length === 0){
              $(".deleteMassage").text("at last select one customer").show().delay(3000).fadeOut('slow');
              return;
          }

          $.ajax({
              url:"/Customer/DownloadSelectedPdf",
              type:"POST",
              traditional:true,
              data:{ids:selectIds},
              xhrFields:{
                  responseType:'blob'
              },
              success:function(blob){
              var link = document.createElement('a');
              link.href = window.URL.createObjectURL(blob);
              link.download='SelectedCustomer.pdf';
              link.click();
              },
              error:function(){
                  $(".deleteMassage").text("Error generating PDF.").show().delay(3000).fadeOut('slow');
              }
          });
        });
         });
