            vertical-align: middle;
            padding: 10px;
        }

        #customerTable th {
            font-size: 14px;
        }

        #customerTable td {
            font-size: 13px;
        }

        #customerTable tbody tr:hover {
            background-color: #f1f1f1;
        }

        #customerTable td a {
            margin: 0 5px;
            color: #007bff;
        }

            #customerTable td a:hover {
                color: #0056b3;
                text-decoration: underline;
            }

    .deleteMassage,
    .successMassage {
        display: block;
        margin-top: 10px;
        padding: 10px;
    }
</style>

