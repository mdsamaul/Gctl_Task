@model IEnumerable<GctlInfoSysTask.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<div id="form-container">
    @Html.Partial("_CustomerForm", new GctlInfoSysTask.ModelDto.CustomerDto())
</div>

<div class="mt-2">
    <span class="text-danger alert-danger deleteMassage d-none"></span>
    <span class="text-success alert-success successMassage d-none"></span>
</div>

<table id="customerTable" class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <td><input type="checkbox" id="selectAll" /></td>
            <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
            <th>@Html.DisplayNameFor(model => model.CustomerName)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.BusinessStart)</th>
            <th>@Html.DisplayNameFor(model => model.CustomerType)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.CreditLimit)</th>
            <th>@Html.DisplayNameFor(model => model.Photo)</th>
            @* <th>Actions</th> *@
        </tr>
    </thead>
    <tbody id="customerTableBody">
        @* এখানে Ajax দিয়ে টেবিল লোড হবে *@
        @Html.Partial("_CustomerTablePartial")
    </tbody>
</table>
