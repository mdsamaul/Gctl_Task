            url: '/Customer/GetCustomers',
            type: "GET",  
            success: function (data) {
                let SrialNb=1;
                let tableBody = "";
                data.forEach(function (customer) {
                    let deliveryAddress = "";
                    console.log(customer);
                    if (customer.deliveryAddressDtos && customer.deliveryAddressDtos.length > 0) {
                        deliveryAddress += `<table class="table bordered">
                            <thead><tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Phone</th>
                            </tr></thead><tbody>
                        `;
                        customer.deliveryAddressDtos.forEach(function (addr) {
                           
                            deliveryAddress += `
                                      <tr>
                            <td>${addr.contactPerson}</td>
                            <td>${addr.deliveryAddressLine}</td>
                            <td>${addr.phone}</td>
                            </tr>
                          `
                        });
                        
                        deliveryAddress += `
                            </tbody>
                            </table>
                        `;
                    } else {
                        deliveryAddress = "";
                    }
                    tableBody += `<tr>
                        <td>${SrialNb}</td >
                        <td>${customer.C}</td >
                    <td>${customer.customerName}</td>
                                <td>
                                  ${customer.photo ? `<img class="ImagePersone" src="/Images/${customer.photo}" width="50" height="50"/>` : `<img src="/Images/photo.jpg" width="50" height="50"/>`}
                                </td>

                    <td>${customer.address}</td>
                    <td>${customer.phone}</td>
                    <td>${customer.email}</td>
                    <td>${customer.customerType ? customer.customerType.customerTypeName : ''}</td>
                    <td>${deliveryAddress}</td>
                    </tr>
                    `
                        SrialNb++;
                });
                $("#customerTable tbody").html(tableBody);
            },
            error: function (error) {
                console.log(error);  
            }
        });
    });
</script>
 