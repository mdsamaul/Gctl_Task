        function recheckAddMoreButton() {
            $('.addmore').hide();
            $('#deliveryAddressContainer .rc:first .addmore').show();
        }

        function updateRowIndexes() {
            $('#deliveryAddressContainer .rc').each(function (index) {
                $(this).find('input').each(function () {
                    let name = $(this).attr('name');
                    if (name) {
                        let updatedName = name.replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', updatedName);
                    }
                });
            });
        }

        function createEmptyRow(index = 0) {
            return `<tr class="rc">
            <td><input name="DeliveryAddresses[${index}].DeliveryAddressLine" class="form-control"/></td>
            <td><input name="DeliveryAddresses[${index}].ContactPerson" class="form-control"/></td>
                <td><input name="DeliveryAddresses[${index}].Phone" class="form-control dAPhone"/></td>
            <td>
                <button type="button" class="btn btn-primary addmore">Add More</button>
                <button type="button" class="btn btn-danger remove">Remove</button>
            </td>
        </tr>`;
        }

       

        $(document).on('click', '.remove', function () {
            $(this).closest('tr').remove();

            if ($('#deliveryAddressContainer .rc').length === 0) {
                $('#deliveryAddressContainer').append(createEmptyRow());
            }

            updateRowIndexes();
            recheckAddMoreButton();
        });

        $(document).on('click', '.addmore', function () {
            let rowCount = $('#deliveryAddressContainer .rc').length;
            $('#deliveryAddressContainer').append(createEmptyRow(rowCount));
            updateRowIndexes();
            recheckAddMoreButton();
        });

        $(document).ready(function () {
            updateRowIndexes();
            recheckAddMoreButton();
        });




