    $(document).ready(function () {
        var firstInvalidField = $(".input-validation-error").first();

        $("input").on("input", function () {
            $(".alert-danger").fadeOut();
        });

        var errorIcon = ' <i class="bi bi-x-circle" style="color: yellow;"></i> ';
        // var errorIcon = '<i class="fas fa-exclamation-circle error-icon-style"></i> ';

        // Field validation error text er sathe icon add & style class add
        $(".field-validation-error").each(function () {
            var currentErrorText = $(this).text().trim();
            $(this).html(errorIcon + currentErrorText);
            $(this).addClass("custom-error-message");
        });

        // Invalid input field-er border color change
        $(".input-validation-error").each(function () {
            $(this).addClass("custom-error-border");

            $(this).on("input", function () {
                $(this).removeClass("input-validation-error custom-error-border");
                var name = $(this).attr("name");
                $("span[data-valmsg-for='" + name + "']")
                    .removeClass("custom-error-message")
                    .text("");
            });
        });

        if (firstInvalidField.length > 0) {
            firstInvalidField.focus();
        }
    });



</script>