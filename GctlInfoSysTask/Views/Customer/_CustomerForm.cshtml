    $(document).ready(function () {
        $("#showCustomerTypeModal").click(function () {
            $.ajax({
                url: '@Url.Action("GetCustomerTypePartial", "Customer")',
                type: 'GET',
                data: {
                    nextCusTypeId: '@ViewBag.nextCusTypeId'
                },
                success: function (response) {
                    debugger;
                    console.log(response.customerType);
                    if ($("#customerTypeModal").length === 0) {
                        $("body").append(response);
                    }
                    $("#customerTypeModal").modal("show");
                }
            });
        });

        const inputs = document.querySelectorAll('input:not([type="submit"]):not([type="reset"]), textarea, select');

        inputs.forEach((input, index) => {
            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    const nextIndex = findNextFocusableIndex(inputs, index);
                    if (nextIndex !== -1) {
                        inputs[nextIndex].focus();
                    }
                }
            });
        });
        function findNextFocusableIndex(elements, currentIndex) {
            for (let i = currentIndex + 1; i < elements.length; i++) {
                const element = elements[i];
                if (!element.disabled && !element.readOnly &&
                    element.type !== 'hidden' &&
                    getComputedStyle(element).display !== 'none' &&
                    getComputedStyle(element).visibility !== 'hidden') {
                    return i;
                }
            }
            return -1;
        }      

    });

   

   
