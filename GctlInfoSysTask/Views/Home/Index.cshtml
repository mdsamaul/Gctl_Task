@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Report Generator</h1>
    <p>Generate reports in different formats.</p>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">PDF Report</h5>
                        <p class="card-text">Generate a PDF report with formatted data.</p>
                        <a href="/api/report/pdf" class="btn btn-primary" target="_blank">Generate PDF</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Excel Report</h5>
                        <p class="card-text">Generate an Excel spreadsheet with data.</p>
                        <a href="/api/report/excel" class="btn btn-success" target="_blank">Generate Excel</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Word Report</h5>
                        <p class="card-text">Generate a Word document with formatted data.</p>
                        <a href="/api/report/word" class="btn btn-info" target="_blank">Generate Word</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>