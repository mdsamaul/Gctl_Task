@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
    $(document).ready(function () {
        console.log("Main view document ready samaul");

        // Show loader function
        function showLoader() {
            // Make sure the loader covers the table area during processing
            $('#tableLoader').css({
                'display': 'flex', // Use flex for centering spinner
                'position': 'absolute', // Position relative to table container
                'top': 0, 'left': 0, 'width': '100%', 'height': '100%',
                'background-color': 'rgba(255, 255, 255, 0.8)',
                'z-index': 10
            });
        }

        // Hide loader function
        function hideLoader() {
            $('#tableLoader').hide();
        }

        // Function to load table data via AJAX
        function loadTableData(page, pageSize, searchString) {
            showLoader(); // Show loader when loading table data

            $.ajax({
                url: '@Url.Action("GetShiftTableData", "Employee")', // Ensure ControllerName is correct
                type: 'GET',
                data: {
                    page: page,
                    pageSize: pageSize,
                    searchString: searchString
                },
                success: function (result) {
                    // Update only the content area (table and potentially pagination info if included in partial)
                    $('#tableDataContainer').html(result);
                    // Re-attach handlers AFTER new content is loaded
                    attachPaginationHandlers();
                     // Update pagination display/info if needed (or handle it within the partial view itself)
                    updatePaginationInfo(); // You might need a function to update 'Showing X to Y of Z' text
                    hideLoader();
                },
                error: function (error) {
                    console.error('Error loading table data:', error);
                    hideLoader();
                    $('#tableDataContainer').html('<div class="alert alert-danger">Error loading data. Please try again.</div>');
                }
            });
        }

        // Function to update the "Showing X to Y of Z" text (example)
        function updatePaginationInfo() {
            // This depends on how your partial returns total counts etc.
            // You might need to adjust this based on your _ShiftTablePartial response
             // Or better, include this text update within the partial itself if possible.
            var totalRows = parseInt($('#tableDataContainer').find('table').data('total-rows') || 0); // Example: get count from table data attribute
            var currentPage = parseInt($('.pagination .active .page-link').text() || 1);
            var pageSize = parseInt($('#pageSizeSelect').val() || 10);
            var startRecord = totalRows === 0 ? 0 : (currentPage - 1) * pageSize + 1;
            var endRecord = Math.min(startRecord + pageSize - 1, totalRows);

            $('#paginationInfo').text(`Showing ${startRecord} to ${endRecord} of ${totalRows} rows`); // Assuming you have <div id="paginationInfo"></div>
        }


        // Function to attach click handlers to pagination links
        function attachPaginationHandlers() {
            // Use event delegation on a static parent container for dynamically loaded links
             // Changed selector to target the container and filter for the links
            $('#tableDataContainer').off('click', '.page-nav-link').on('click', '.page-nav-link', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                var pageSize = $('#pageSizeSelect').val();
                var searchString = $('#searchString').val();
                loadTableData(page, pageSize, searchString);
            });
        }

        // Initial load and attachment
        // Load initial data on page load (optional, if not SSR)
        // var initialPage = 1;
        // var initialPageSize = $('#pageSizeSelect').val();
        // var initialSearch = $('#searchString').val();
        // loadTableData(initialPage, initialPageSize, initialSearch); // Uncomment if you want AJAX load on start

        attachPaginationHandlers(); // Attach handlers for initially rendered pagination

        // Update table data on pageSize change
        $('#pageSizeSelect').on('change', function () {
            var selectedPageSize = $(this).val();
            var currentSearchString = $('#searchString').val();
            // No need to showLoader here, loadTableData does it
            loadTableData(1, selectedPageSize, currentSearchString); // Go back to page 1
        });

        // Auto search as you type with debounce
        let searchTimeout;
        $('#searchString').on('input', function() {
            // No need to showLoader here directly
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                var searchValue = $('#searchString').val();
                var selectedPageSize = $('#pageSizeSelect').val();
                 // loadTableData will show the loader
                loadTableData(1, selectedPageSize, searchValue); // Go back to page 1
            }, 500); // 500ms delay
        });

        // Assign shifts button click handler
        $('#assignShifts').on('click', function (e) {
            e.preventDefault();

            // --- Validation ---
            var fromDateStr = $('#fromDate').val();
            var toDateStr = $('#toDate').val();
            var shiftValue = $('#shift').val(); // Get shift value (should be the ID/Code)

            if (!fromDateStr || !toDateStr) {
                alert("Please select both From Date and To Date.");
                return;
            }

            // *** INTEGRATED SNIPPET PART 1: Specific Shift Validation ***
            if (!shiftValue) { // Check if a shift is selected using the specific value
                alert("Please select a Shift."); // Use the specific message
                return;
            }
            // --- End Basic Input Validation ---


            // --- Employee Selection Validation ---
            var selectedEmployeeIds = [];
            $('.employee-checkbox:checked').each(function () {
                selectedEmployeeIds.push(parseInt($(this).val())); // Ensure IDs are integers
            });

            if (selectedEmployeeIds.length === 0) {
                alert("Please select at least one employee.");
                return;
            }
            // --- End Employee Selection ---


            // --- Large Operation Warning ---
            var fromDate = new Date(fromDateStr);
            var toDate = new Date(toDateStr);
            // Basic date validation (ensure valid dates were parsed)
            if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
                 alert("Invalid date format entered.");
                 return;
            }
            if (fromDate > toDate) {
                 alert("From Date cannot be after To Date.");
                 return;
            }

            var dayDiff = Math.max(0, Math.floor((toDate - fromDate) / (1000 * 60 * 60 * 24)) + 1); // Ensure non-negative diff
            var totalRecords = selectedEmployeeIds.length * dayDiff;

            if (totalRecords > 5000) { // Keep the warning threshold
                if (!confirm(`You are about to process approximately ${totalRecords} schedule entries. This might take some time. Continue?`)) {
                    return; // Stop if user cancels
                }
            }
            // --- End Large Operation Warning ---


            // --- Prepare Data for AJAX ---
            // *** INTEGRATED SNIPPET PART 2: Data Object Creation ***
            var data = {
                selectedEmployeeIds: selectedEmployeeIds,
                fromDate: fromDateStr,
                toDate: toDateStr,
                shift: shiftValue, // Send the selected shift code/ID
                remarks: "Assigned via bulk operation" // Added remarks field
                // If you add an input: remarks: $('#yourRemarksInputId').val() || "Default remark"
            };
            // --- End Data Preparation ---


            // --- AJAX Call ---
            var $button = $(this); // Reference to the button
            showLoader(); // Show loader covering the table
            $button.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("AssignShifts", "Employee")', // Ensure ControllerName is correct
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify(data),
                success: function (response) {
                    // Use server response message
                    alert(response.message || (response.success ? "Operation successful." : "An unknown error occurred."));

                    if (response.success) {
                         // Reload the table data on success ONLY
                        var selectedPageSize = $('#pageSizeSelect').val();
                        var currentSearchString = $('#searchString').val();
                        // loadTableData handles its own loader/hideLoader
                        loadTableData(1, selectedPageSize, currentSearchString); // Refresh table to show changes
                    }
                },
                error: function (xhr) {
                    // Try to parse error response
                    let errorMessage = "An error occurred while assigning shifts.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = `Error: ${xhr.responseJSON.message}`;
                    } else if (xhr.statusText) {
                         errorMessage = `Error: ${xhr.status} ${xhr.statusText}`;
                    }
                    console.error("AssignShifts Error:", xhr); // Log detailed error
                    alert(errorMessage);
                    // Do NOT reload table data on error generally
                },
                complete: function() {
                    // This runs regardless of success or error
                    hideLoader(); // Hide the main table loader
                    $button.prop('disabled', false).html('Assign Shifts'); // Always re-enable button
                }
