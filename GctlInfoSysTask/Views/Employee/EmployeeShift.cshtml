@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    // Add other necessary JS libraries like DataTables if used elsewhere on the page
    <script>
    $(document).ready(function () {
        console.log("Main view document ready samaul");

        // Loader functions (keep as they are)
        function showLoader() {
            $('#tableLoader').css({
                'display': 'flex', 'position': 'absolute', 'top': 0, 'left': 0, 'width': '100%', 'height': '100%',
                'background-color': 'rgba(255, 255, 255, 0.8)', 'z-index': 10
            }).show();
        }
        function hideLoader() {
            $('#tableLoader').hide();
        }

        // Function to load table data via AJAX (keep as is)
        function loadTableData(page, pageSize, searchString) {
            showLoader();
            $.ajax({
                url: '@Url.Action("GetShiftTableData", "Employee")', // Ensure Controller name is correct
                type: 'GET',
                data: { page: page, pageSize: pageSize, searchString: searchString },
                success: function (result) {
                    $('#tableDataContainer').html(result);
                    attachPaginationHandlers();
                    updatePaginationInfo(); // Make sure this function exists or is handled
                    hideLoader();
                },
                error: function (error) {
                    console.error('Error loading table data:', error);
                    hideLoader();
                    $('#tableDataContainer').html('<div class="alert alert-danger">Error loading data. Please try again.</div>');
                }
            });
        }

        // Function to update pagination info (Example, adapt as needed)
        function updatePaginationInfo() {
             // Implement logic to update text like "Showing 1 to 10 of 50"
             // Needs info passed from the partial view or calculated client-side
             // e.g., $('#paginationInfo').text(...)
             console.log("Pagination info update needed.");
        }


        // Function to attach click handlers to pagination links (keep as is)
        function attachPaginationHandlers() {
            $('#tableDataContainer').off('click', '.page-nav-link').on('click', '.page-nav-link', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                var pageSize = $('#pageSizeSelect').val();
                var searchString = $('#searchString').val();
                loadTableData(page, pageSize, searchString);
            });
        }

        // Initial setup (keep as is)
        attachPaginationHandlers();
        // Optional initial load: loadTableData(1, $('#pageSizeSelect').val(), $('#searchString').val());

        // Page size change handler (keep as is)
        $('#pageSizeSelect').on('change', function () {
            loadTableData(1, $(this).val(), $('#searchString').val());
        });

        // Search input handler (keep as is)
        let searchTimeout;
        $('#searchString').on('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                loadTableData(1, $('#pageSizeSelect').val(), $('#searchString').val());
            }, 500);
        });

        // Assign shifts button click handler (Focus on the confirmation part)
        $('#assignShifts').on('click', function (e) {
            e.preventDefault();

            // --- Validation (Keep all previous validation) ---
            var fromDateStr = $('#fromDate').val();
            var toDateStr = $('#toDate').val();
            var shiftValue = $('#shift').val(); // Should be Shift ID

            if (!fromDateStr || !toDateStr || !shiftValue) {
                alert("Please fill all required fields (From Date, To Date, and Shift).");
                return;
            }
            var selectedEmployeeIds = [];
            $('.employee-checkbox:checked').each(function () {
                selectedEmployeeIds.push(parseInt($(this).val()));
            });
            if (selectedEmployeeIds.length === 0) {
                alert("Please select at least one employee.");
                return;
            }
            // --- End Validation ---


            // --- Large Operation Warning ---
            var fromDate = new Date(fromDateStr);
            var toDate = new Date(toDateStr);
            if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime()) || fromDate > toDate) {
                 alert("Invalid date range selected.");
                 return;
            }
            var dayDiff = Math.max(0, Math.floor((toDate - fromDate) / (1000 * 60 * 60 * 24)) + 1);
            var totalRecords = selectedEmployeeIds.length * dayDiff;

            // ******************************************************
            // THIS IS JUST A WARNING! You MUST click "OK" to continue.
            // If clicking OK still fails, the problem is SERVER-SIDE (Timeout, etc.)
            // ******************************************************
            if (totalRecords > 1000000) { // Keep warning threshold reasonable
                if (!confirm(`You are about to process approximately ${totalRecords.toLocaleString()} schedule entries. This might take a significant amount of time (${Math.ceil(totalRecords / 50000)} min+). Continue?`)) {
                    // If user clicks CANCEL, we stop here. This is INTENDED.
                    console.log("User cancelled large operation.");
                    return;
                }
                 // If user clicks OK, we proceed below.
                 console.log("User confirmed large operation.");
            }
            // --- End Large Operation Warning ---


            // --- Prepare Data for AJAX (Keep as is) ---
            var data = {
                selectedEmployeeIds: selectedEmployeeIds,
                fromDate: fromDateStr,
                toDate: toDateStr,
                shift: shiftValue,
                remarks: $('#remarksInput').val() || "Assigned via bulk operation" // Get remarks if you have an input
            };
            // --- End Data Preparation ---


            // --- AJAX Call (Keep as is, relies on server timeout) ---
            var $button = $(this);
            showLoader();
            $button.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("AssignShifts", "Employee")', // Ensure Controller name is correct
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify(data),
                success: function (response) {
                    alert(response.message || (response.success ? "Operation successful." : "An unknown error occurred."));
                    if (response.success) {
                        // Reload table data on success
                        loadTableData(1, $('#pageSizeSelect').val(), $('#searchString').val());
                    }
                },
                error: function (xhr) {
                    let errorMessage = "An error occurred while assigning shifts.";
                    // Try to get message from server response
                     if (xhr.responseJSON && xhr.responseJSON.message) {
                         errorMessage = `Error: ${xhr.responseJSON.message}`; // Use the specific error from C#
                     } else if (xhr.statusText === "timeout") {
                         errorMessage = "Error: The request timed out while waiting for the server. The operation might be too large.";
                     } else if (xhr.statusText) {
                         errorMessage = `Error: ${xhr.status} ${xhr.statusText}`;
                     }
                    console.error("AssignShifts Error Details:", xhr);
                    alert(errorMessage);
                },
                complete: function() {
                    hideLoader();
                    $button.prop('disabled', false).html('Assign Shifts');
                }
            });
            // --- End AJAX Call ---
        });

        // Event delegation for edit/delete (Keep as is)
        $('#tableDataContainer').on('click', '.edit-shift, .delete-shift', function() {
            var id = $(this).data('id');
            var action = $(this).hasClass('edit-shift') ? 'Edit' : 'Delete';
            console.log(action + " clicked for ID:", id);
            if (action === 'Delete') {
                 if (!confirm('Are you sure you want to delete this shift record? ID: ' + id)) {
                     return;
                 }
                 // Add AJAX call for delete here
                 console.log("Proceeding with delete for ID:", id);
            } else {
                 // Add logic for edit here (e.g., open modal)
                 console.log("Proceeding with edit for ID:", id);
            }
        });

    }); // End $(document).ready
    </script>
