@model IEnumerable<GctlInfoSysTask.Models.Customer>
<h2>Customer List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Customer Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerId</td>
                <td>@item.CustomerName</td>
                <td>
                    <a href="@Url.Action("ExportToWord", "CustomerInformation", new { id = item.AI_ID })" class="btn btn-primary">
                        Export to Word
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>