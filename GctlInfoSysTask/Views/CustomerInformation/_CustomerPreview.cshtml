@model GctlInfoSysTask.Models.Customer

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Customer Preview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4">
                    @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="/Images/@Model.Photo" alt="Customer Photo" class="img-fluid rounded mb-3" />
                    }
                    else
                    {
                        <div class="text-center p-3 bg-light rounded mb-3">
                            <i class="fas fa-user fa-4x text-secondary"></i>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h4>@Model.CustomerName</h4>
                    <p class="text-muted">@Model.CustomerType</p>

                    <div class="mb-3">
                        <small class="text-muted">Contact Information</small>
                        <div class="d-flex flex-column">
                            <span><i class="fas fa-phone-alt me-2"></i> @Model.Phone</span>
                            <span><i class="fas fa-envelope me-2"></i> @Model.Email</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Address</small>
                        <p>@Model.Address</p>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Business Start</small>
                            <p>@Model.BusinessStart?.ToString("yyyy-MM-dd")</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Credit Limit</small>
                            <p>@Model.CreditLimit?.ToString("C")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</div>


