@section Scripts {
    <script>

        $("#selectAll").click(function(){
            $(".selectCheckBox").prop("checked",this.checked);
        })
        $(".selectCheckBox").on('change', function(){
            const totalSelect = $(".selectCheckBox").length;
            const selectCheck = $(".selectCheckBox:checked").length;
            if(totalSelect == selectCheck){
                $("#selectAll").prop('checked', true);
            }else{
                $("#selectAll").prop('checked', false);
            }
        })
        $("#downloadA4").click(function(){
          var selectIds =[];
          $('.selectCheckBox:checked').each(function(){
              selectIds.push($(this).val());
          })
          if(selectIds.length === 0){
              $(".deleteMassage").text("at last select one customer").show().delay(3000).fadeOut('slow');
          }
          $.ajax({
          url:'/CustomerInformation/DownloadPdfA4',
          type:"POST",
          traditional:true,
          data:{ids:selectIds},
          xhrFields:{
              responseType:'blob'
          },success:function(blob){
              // console.log(blob);
              var link= document.createElement('a');
              link.href= window.URL.createObjectURL(blob);
              link.download='SelectedCustomer.pdf';
              link.click();
          },error:function(){
                $(".deleteMassage").text("Error generating PDF.").show().delay(3000).fadeOut('slow');
          }

          })
        })
         $("#customerDownloadSelectedPdf").click(function(){
            console.log("click");
          var selectIds = [];
              $(".selectCheckBox:checked").each(function(){
          selectIds.push($(this).val());
          });
          if(selectIds.length === 0){
              $(".deleteMassage").text("at last select one customer").show().delay(3000).fadeOut('slow');
              return;
          }

          $.ajax({
              url:"/CustomerInformation/DownloadSelectedPdf",
              type:"POST",
              traditional:true,
              data:{ids:selectIds},
              xhrFields:{
                  responseType:'blob'
              },
              success:function(blob){
              var link = document.createElement('a');
              link.href = window.URL.createObjectURL(blob);
              link.download='SelectedCustomer.pdf';
              link.click();
              },
              error:function(){
                  $(".deleteMassage").text("Error generating PDF.").show().delay(3000).fadeOut('slow');
              }
          });
           });




        $(document).ready(function() {
            // Initialize DataTable with date range filtering capability
            var table = $('#customerTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]]
            });

            // Custom date range filtering function
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    var startDate = $('#startDate').val();
                    var endDate = $('#endDate').val();
                    var dateColumn = data[2]; // Index of "Business Start" column

                    // If no dates are selected, show all rows
                    if (!startDate && !endDate) {
                        return true;
                    }

                    // Parse dates for comparison
                    var rowDate = new Date(dateColumn);
                    var filterStartDate = startDate ? new Date(startDate) : null;
                    var filterEndDate = endDate ? new Date(endDate) : null;

                    // Check if the date is within the selected range
                    if (filterStartDate && filterEndDate) {
                        return rowDate >= filterStartDate && rowDate <= filterEndDate;
                    } else if (filterStartDate) {
                        return rowDate >= filterStartDate;
                    } else if (filterEndDate) {
                        return rowDate <= filterEndDate;
                    }

                    // Default case
                    return true;
                }
            );

            // Apply filter when the filter button is clicked
            $('#filterDateBtn').click(function() {
                table.draw();
            });

            // Reset date filters
            $('#clearDateFilterBtn').click(function() {
                $('#startDate').val('');
                $('#endDate').val('');
                table.draw();
            });

            $(".column-filter").change(function () {
                var column = $(this).data("column");
                var value = $(this).val();
                table.column(column).search(value).draw();
            });

            $(".customer-name-filter").change(function () {
                var selectedValues = $(".customer-name-filter:checked").map(function () {
                    return this.value;
                }).get();

                if (selectedValues.length === 0) {
                    table.column(0).search('').draw();
                } else {
                    var pattern = selectedValues.join("|");
                    table.column(0).search(pattern, true, false).draw();
                }
            });

           
        });
    </script>
}